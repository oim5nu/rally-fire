# Browser-safe Supabase values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
POSTGRES_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres
INITIAL_SUPERADMIN_EMAIL=owner@example.com
ADMIN_SESSION_TTL_HOURS=8
